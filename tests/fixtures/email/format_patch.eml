From 3f2b9c1e0d4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c Mon Sep 17 00:00:00 2001
From: Frank Developer <frank.developer@example.org>
Date: Sat, 17 Jan 2026 12:00:00 +0000
Subject: [PATCH 1/1] hdr: bound the chunk length in hdr_decode_chunked_value

The chunk length was trusted before the copy. Reject values larger than
the destination, which fixes the heap overflow reported against 1.2.0.
---
 src/hdr.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/hdr.c b/src/hdr.c
index 1111111..2222222 100644
--- a/src/hdr.c
+++ b/src/hdr.c
@@ -410,4 +410,6 @@ static int hdr_decode_chunked_value(hdr_ctx *ctx, const char *in, size_t n) {
     char tmp[64];
+    if (n > sizeof(tmp))
+        return HDR_ERR_TOO_LONG;
     memcpy(tmp, in + ctx->chunk_off, n);
     return hdr_emit(ctx, tmp, n);
 }
